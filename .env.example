# ==============================================================================
# CHIROSUHRID (SUHRID) NGO — Supabase Environment Configuration
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste it into VITE_SUPABASE_URL
# 4. Copy "anon public" Project API Key and paste it into VITE_SUPABASE_ANON_KEY
# 5. In Supabase SQL Editor, run the script provided in /supabase_schema.sql
#
# NOTE: If these variables are empty or placeholders, the Chirosuhrid Admin Panel
# automatically operates in Instant Local Demo Mode with full browser persistence,
# so you can test all features immediately!
# ==============================================================================

VITE_SUPABASE_URL=https://placeholder-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
